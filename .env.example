# ============================================================================
# Consenso IA — Model Council MAGI
# Copiá este archivo a `.env` y completá las keys. NUNCA commitees `.env`.
# ============================================================================

# --- OpenRouter (obligatorio para el consejo) -------------------------------
# Conseguí una key gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key

# Opcional: credenciales adicionales para el pool de OpenRouter. El código
# descubre OPENROUTER_API_KEY_2, _3, _4… automáticamente (no hace falta que
# sean consecutivas). Se rotan cuando una se agota o queda inválida.
# OPENROUTER_API_KEY_2=

# Identidad que OpenRouter usa para atribuir el tráfico (headers
# HTTP-Referer / X-Title). Defaults si se omiten.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Consenso IA

# Modelo del Coding Agent (loop legacy y autonomía). Default:
# nvidia/nemotron-3.5-lightning:free
# OPENROUTER_CODING_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Proveedores directos (opcionales) --------------------------------------
# NVIDIA NIM directo (https://build.nvidia.com). Cupo separado del pool
# gratuito compartido de OpenRouter. Si se omite, todo sigue funcionando
# solo por OpenRouter.
NVIDIA_API_KEY=nvapi-your-key

# Google AI Studio directo (https://aistudio.google.com/apikey). Habilita
# los Gemini nativos (3.7 Flash, 3.1 Pro Preview, 2.5 Flash-Lite). Si se
# omite, esos modelos no aparecen seleccionables.
GEMINI_API_KEY=your-gemini-api-key

# --- Modelos del pipeline (opcionales) --------------------------------------
# Default de los tres: nvidia/nemotron-3.5-lightning:free
SYNTHESIS_MODEL=nvidia/nemotron-3.5-lightning:free
FUSION_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free
FOLLOWUP_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Agente de archivos / Coding Agent --------------------------------------
# Raíz que el agente de filesystem puede leer y proponer cambios. Default:
# la carpeta del proyecto. El agente nunca puede escapar de esta raíz,
# symlinks incluidos.
AGENT_FS_ROOT=

# Habilita la tool web_search del Coding Agent (https://tavily.com, tiene
# free tier). Si se omite, el agente funciona igual pero sin web_search.
TAVILY_API_KEY=tvly-your-key

# Token de GitHub para las tools del conector GitHub (búsqueda/lectura de
# repos). Si se omite, esas tools no están disponibles.
GITHUB_TOKEN=github_pat_your-token

# Autonomous Loop opt-in. Sin esto, el Coding Agent usa el loop legacy.
# Valores aceptados: 1, true, yes, on.
# MAGI_AUTONOMOUS_LOOP=1

# Apaga el context engine (briefing + repo-map + presupuesto por paso) sin
# tocar código. Valores aceptados: 1, true, yes, on.
# MAGI_CONTEXT_ENGINE_DISABLED=1

# Apaga el governor del historial (compactación del contexto al acercarse al
# presupuesto blando) sin tocar código. Desde la Etapa 2.2 está PRENDIDO por
# defecto, pero solo corre cuando la ventana de contexto del modelo es conocida.
# Sirve para medir el antes/después en la misma máquina y como salida de
# emergencia. Valores aceptados: 1, true, yes, on.
# MAGI_HISTORY_GOVERNOR_DISABLED=1

# Etapa 2.3: permite los bloques de shell (`!`cmd``) dentro de las plantillas de
# comandos del agente (.magi/commands/*.md). APAGADO por defecto a proposito: un repo
# clonado (o cualquier tercero que edite un .md) podria ejecutar codigo con los
# privilegios del usuario con solo pedir una task. Prenderlo es una decision explicita.
# Cuando esta prendido, la salida se redacta (secretos), se recorta a 8.000 caracteres
# y se marca como dato no confiable, nunca como instruccion.
# MAGI_AGENT_COMMANDS_SHELL=1

# --- Seguridad de /api/* (Fase 1) -------------------------------------------
# Lista separada por comas de Host permitidos. Si se omite, se permiten
# localhost, 127.0.0.1 y [::1] con el puerto de PORT (o 3000 por defecto).
# Una entrada sin puerto acepta cualquier puerto de ese host.
# ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,[::1]:3000

# Orígenes permitidos para POST/PUT/PATCH/DELETE. Si se omite, se acepta el
# mismo origen del Host permitido (http y https). Lista separada por comas,
# cada entrada con esquema. No se soportan comodines.
# ALLOWED_ORIGINS=http://localhost:3000

# Opcional: si se define, todo /api/* exige Authorization: Bearer <token>
# o la cookie magi_access_token=<token>. Si se omite, no se exige token.
# La app sigue siendo single-user: esto es una cerradura extra, no un login.
# APP_ACCESS_TOKEN=

# Fase 4c — clave para cifrar los secretos TOTP de los dispositivos
# emparejados. Sin ella (y sin APP_ACCESS_TOKEN) NO se puede anotar un
# dispositivo con segundo factor: es a propósito, el secreto no se guarda en
# claro. Cualquier string largo y privado sirve; no se vuelve a leer después.
# MAGI_TOTP_KEY=

# Fase 5 — kill switch del acceso remoto. Con "off" se rechaza TODO Host que
# no sea loopback (localhost/127.0.0.1/[::1]), incluso con token o dispositivo.
# Valores: "" (sin efecto, default), "on", "off".
# REMOTE_ACCESS=

# Puerto del servidor. Se usa para armar los defaults de ALLOWED_HOSTS y
# ALLOWED_ORIGINS cuando no están definidos. Next también lo respeta con
# `next dev -p` / `next start -p`; definilo acá si corrés en otro puerto.
# PORT=3000
