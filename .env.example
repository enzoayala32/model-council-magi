OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Consenso IA
GITHUB_TOKEN=github_pat_your-token

# Optional: direct NVIDIA NIM fallback (build.nvidia.com, free developer
# tier, separate quota from OpenRouter's shared free pool). When set, any
# Nemotron model that exhausts its OpenRouter retries automatically retries
# once directly against NVIDIA's own API before failing. Leave blank to
# disable — everything still works through OpenRouter alone without it.
NVIDIA_API_KEY=nvapi-your-key

# Optional: direct Google AI Studio access for Gemini council models (Gemini
# 3.7 Flash, 3.1 Pro Preview, 2.5 Flash-Lite). Get a free key at
# aistudio.google.com/apikey. Called through Google's own OpenAI-compatible
# endpoint, not OpenRouter — a separate quota/billing relationship with
# Google. Leave blank and those three models simply won't be selectable.
GEMINI_API_KEY=your-gemini-api-key

SYNTHESIS_MODEL=nvidia/nemotron-3.5-lightning:free
FUSION_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free
FOLLOWUP_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional: root folder the file agent (filesystem connector) is allowed to
# read from and propose changes to. Defaults to the project's own folder if
# unset, so a fresh clone is safe out of the box. The agent can never escape
# this root, symlinks included.
AGENT_FS_ROOT=

# Optional: enables the Coding Agent's web_search tool (Phase 6B). Get a free
# key at tavily.com (free tier available). Leave blank to disable — the
# Agent works exactly as before, web_search simply isn't offered as a tool.
TAVILY_API_KEY=tvly-your-key

# --- Seguridad de /api/* (Fase 1) ---
# Lista separada por comas de Host permitidos. Si se omite, se permiten
# localhost, 127.0.0.1 y [::1] con el puerto de PORT (o 3000 por defecto).
# Una entrada sin puerto acepta cualquier puerto de ese host.
# ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,[::1]:3000

# Orígenes permitidos para POST/PUT/PATCH/DELETE. Si se omite, se acepta el
# mismo origen del Host permitido (http y https). Lista separada por comas,
# cada entrada con esquema. No se soportan comodines.
# ALLOWED_ORIGINS=http://localhost:3000

# Opcional: si se define, todo /api/* exige Authorization: Bearer <token>
# o la cookie magi_access_token=<token>. Si se omite, no se exige token.
# La app sigue siendo single-user: esto es una cerradura extra, no un login.
# APP_ACCESS_TOKEN=
